{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "python-http-server",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8000"],
      "port": 8000
    },
    {
      "name": "npx-serve",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "serve", "."],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "npx-http-server",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["-y", "http-server", "."],
      "port": 8080,
      "autoPort": true
    }
  ]
}
