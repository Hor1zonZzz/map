.DS_Store
node_modules

# POI build artifacts (regenerate via scripts/build-pois.mjs)
data/raw/
data/.pois-build/
data/.regeo-progress.json

# Per-district shards stay local by default to avoid repo bloat.
# If you deploy with shard-level lazy loading, publish data/pois/ in the deploy artifact
# (or remove this ignore rule and commit the shards).
data/pois/
.deploy/
dist/

# Secrets — never commit
.env
.env.*
!.env.example

# Claude Code / editor local state
.claude/
