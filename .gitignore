.DS_Store
node_modules

# POI build artifacts (regenerate via scripts/build-pois.mjs)
data/raw/
data/.pois-build/
data/.regeo-progress.json

# Per-district shards — only the packed tarball is committed; loose shards stay local.
# (Run scripts/build-pois.mjs then scripts/package-pois.mjs to regenerate both.)
data/pois/

# Secrets — never commit
.env
.env.*
!.env.example

# Claude Code / editor local state
.claude/
